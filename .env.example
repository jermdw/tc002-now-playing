# ============================================================================
# Ulanzi TC002 / AWTRIX NG Connection
# Use your clock's static LAN IP (recommended over .local mDNS inside Docker)
# ============================================================================
AWTRIX_HOST=192.168.1.50
AWTRIX_PORT=80
AWTRIX_USERNAME=
AWTRIX_PASSWORD=
AWTRIX_APP_NAME=now-playing

# Automatically install/update the companion Berry script & server_url on boot
AUTO_INSTALL_SCRIPT=true

# ============================================================================
# Bridge HTTP Server Settings
# SERVER_LAN_URL must be reachable by your TC002 over Wi-Fi!
# Replace 192.168.1.100 with the LAN IP of the machine running this bridge.
# ============================================================================
PORT=8765
SERVER_LAN_URL=http://192.168.1.100:8765

# ============================================================================
# Mac Now Playing (enabled when PUSH_TOKEN is set)
# Generate a token with: openssl rand -hex 32
# The agent on your Mac must use the same value.
# ============================================================================
PUSH_TOKEN=
PUSH_TTL_MS=15000

# ============================================================================
# Spotify (optional; enabled when both values are set)
# https://developer.spotify.com/dashboard
# The app's Redirect URI must match exactly, and Spotify bans "localhost":
#   http://127.0.0.1:8765/callback
# ============================================================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

# ============================================================================
# Display & Polling Tuning
# ============================================================================
POLL_ACTIVE_MS=2000
POLL_IDLE_MS=5000
PAUSE_GRACE_MS=6000
SWITCH_ON_TRACK_CHANGE=true
ASCII_TRANSLITERATE=true
LED_GAMMA=1.55
LED_SATURATION=1.25
